# Containerlab runtime output — regenerated by `containerlab deploy`.
# Only source files (topologies, configs, scripts, docs) are tracked.

# Containerlab runtime directories (any depth, any lab folder), e.g.
# arista-mlag-lab/clab-arista-mlag-lab/, segment-routing-lab2/clab-segment-routing-lab2/
**/clab-*/

# XR TAM/storage state dirs written by XRd containers (any depth)
**/xr-storage/

# Runtime logs
*.log

# Containerlab-generated topology graph/annotation metadata
topology-data.json
*.annotations.json

# Misc backup files
*.bak
